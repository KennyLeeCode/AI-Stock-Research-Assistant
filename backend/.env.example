# =====================================================================
# Copy this file to `backend/.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real keys.
# =====================================================================

# ---------- Application ----------
APP_NAME="AI Stock Research Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Database ----------
# SQLite for development. Swap this single URL for PostgreSQL or MySQL later:
#   postgresql+psycopg://user:password@localhost:5432/stockresearch
#   mysql+pymysql://user:password@localhost:3306/stockresearch
DATABASE_URL=sqlite:///./stock_research.db

# ---------- Market data provider (Alpha Vantage) ----------
# Free key: https://www.alphavantage.co/support/#api-key
MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# ---------- AI provider (Anthropic) ----------
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8000

# ---------- HTTP behaviour ----------
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# ---------- Caching (in-process TTL cache, seconds) ----------
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORY=3600
CACHE_TTL_OVERVIEW=86400
CACHE_TTL_NEWS=900
CACHE_TTL_RESEARCH=3600

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
